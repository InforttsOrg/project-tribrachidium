# Tribrachidium — environment declaration.
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# This file is the contract: validate-release.sh fails the release if repo code reads an
# environment variable that is not declared here.

# Hugging Face write token, used by ci/upload_to_hf.py to publish the release manifest
# (and any APK/OTA artifacts) to the rttss/ota-patches dataset CDN.
# Create a write-scoped token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Accepted as an alternative to HF_TOKEN (checked when HF_TOKEN is unset).
HUGGING_FACE_HUB_TOKEN=
